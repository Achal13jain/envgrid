# Copy to .env and fill in. Never commit the real .env.

# Required. 32 random bytes, base64. Generate with: envgrid genkey
# Keep a copy in your password manager: without it the database cannot be read.
ENVGRID_MASTER_KEY=

# Used once, on the first start with an empty database, to create the first admin.
ENVGRID_ADMIN_EMAIL=admin@example.com
ENVGRID_ADMIN_PASSWORD=

# Keep true in production (HTTPS). Set false only to try envgrid over plain HTTP.
ENVGRID_SECURE_COOKIES=true

# Set true only when envgrid sits behind exactly one reverse proxy that sets X-Forwarded-For.
ENVGRID_TRUST_PROXY=false

# Optional: debug, info, warn or error.
ENVGRID_LOG_LEVEL=info
