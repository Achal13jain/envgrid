# Build output
/envgrid
/envgrid.exe
/bin/
/dist/
frontend/dist/*
frontend/dist-site/
# Only what the app needs to build, run, test and release goes to GitHub.
# Notes and media live in _local/. Browser tests and the Go lint config
# stay in place so they keep working locally, but are not published.
_local/
*.zip
frontend/e2e/
frontend/playwright.config.ts
.golangci.yml
!frontend/dist/.gitkeep
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/
frontend/*.tsbuildinfo

# Local data and secrets
/data/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example
!frontend/.env.site
*.pem
*.key
