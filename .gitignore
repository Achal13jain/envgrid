# Build output
/envgrid
/envgrid.exe
/bin/
/dist/
frontend/dist/*
frontend/dist-site/
# Only what the app needs to build, run and release goes to GitHub.
# Notes, media, templates and CI live in _local/; tests and lint
# configs stay in place so they keep working, but are not published.
_local/
*_test.go
frontend/e2e/
frontend/src/**/*.test.ts
frontend/playwright.config.ts
frontend/eslint.config.js
.golangci.yml
!frontend/dist/.gitkeep
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/
frontend/*.tsbuildinfo

# Local data and secrets
/data/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example
!frontend/.env.site
*.pem
*.key
